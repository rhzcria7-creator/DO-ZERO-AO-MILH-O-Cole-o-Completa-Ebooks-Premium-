rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // GLOBAL SAFETY NET
    // ============================================================
    // By default, deny all reads and writes. Each collection below
    // explicitly re-enables the operations it needs. This prevents
    // accidental exposure if a new collection is added without rules.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ============================================================
    // PURCHASES — writes are blocked on the client side.
    // The backend (Firebase Admin SDK with elevated privileges)
    // is the ONLY writer. The client may only read its own
    // purchase records. This closes the payment-bypass vector
    // where the front-end could self-issue an "approved" status.
    // ============================================================
    function isValidPurchase(data) {
      return data.keys().hasAll(['userId', 'ebookId', 'status', 'purchaseDate', 'amount'])
        && data.userId is string
        && data.ebookId is string
        && data.status in ['approved', 'pending', 'failed', 'refunded']
        && data.amount is number;
    }

    match /purchases/{purchaseId} {
      // Only the owner can read.
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      // No client-side writes. Backend (Admin SDK) bypasses rules.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // DOWNLOADS — same posture: backend-only writes.
    // ============================================================
    function isValidDownload(data) {
      return data.keys().hasAll(['userId', 'purchaseId', 'ebookId', 'downloadDate'])
        && data.userId is string
        && data.purchaseId is string
        && data.ebookId is string;
    }

    match /downloads/{downloadId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // USER PROFILES — users can read/update their own profile.
    // ============================================================
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && incoming().uid == uid;
      allow delete: if false;
    }
  }
}
