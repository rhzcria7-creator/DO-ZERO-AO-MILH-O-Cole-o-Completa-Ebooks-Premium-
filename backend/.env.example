# ===========================================
# SERVIDOR
# ===========================================
NODE_ENV=development
PORT=3000
TRUST_PROXY=true

# ===========================================
# DOMÍNIOS (CORS)
# ===========================================
ALLOWED_ORIGINS=http://localhost:5173

# ===========================================
# SESSÃO
# ===========================================
# Gere com: openssl rand -hex 64
COOKIE_SECRET=your-6...here

# ===========================================
# BANCO DE DADOS (PostgreSQL via Supabase)
# ===========================================
# Connection string do Supabase (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ===========================================
# SUPABASE
# ===========================================
# Settings > API > Project URL
SUPABASE_URL=https://xxxxx.supabase.co
# Settings > API > service_role key (NÃO expor no frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Settings > API > anon/public key (para o frontend)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# E-MAIL (SendGrid ou SMTP)
# ===========================================
EMAIL_PROVIDER=smtp
# SendGrid
# SENDGRID_API_KEY=SG.xxx
# SMTP (alternativa - funciona com Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM=seu-email@gmail.com
EMAIL_FROM_NAME=Do Zero ao Milhão

# ===========================================
# DOWNLOAD SEGURO
# ===========================================
# Gere com: openssl rand -hex 64
DOWNLOAD_SECRET=your-64-char-hex-secret-here
DOWNLOAD_URL=https://dozeroaomilhao.com

# ===========================================
# ADMIN
# ===========================================
# Gere hash com: node -e "console.log(require('./backend/src/services/auth').hashPassword('sua-senha'))"
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD_HASH=xxxx:xxxx
# Gere API key com: openssl rand -hex 32
ADMIN_API_KEY=your-32-char-hex-api-key-here

# ===========================================
# LOG
# ===========================================
LOG_LEVEL=info
