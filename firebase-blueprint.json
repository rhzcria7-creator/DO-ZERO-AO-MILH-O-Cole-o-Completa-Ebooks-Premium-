{
  "entities": {
    "Purchase": {
      "title": "Purchase",
      "description": "A record of an ebook purchase.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID of the purchaser."
        },
        "ebookId": {
          "type": "string",
          "description": "The ID of the ebook."
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "failed"]
        },
        "purchaseDate": {
          "type": "string",
          "format": "date-time"
        },
        "amount": {
          "type": "number",
          "description": "Total amount paid."
        }
      },
      "required": ["userId", "ebookId", "status", "purchaseDate", "amount"]
    },
    "Download": {
      "title": "Download",
      "description": "A record of an ebook download.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "purchaseId": {
          "type": "string"
        },
        "ebookId": {
          "type": "string"
        },
        "downloadDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "purchaseId", "ebookId", "downloadDate"]
    }
  },
  "firestore": {
    "/purchases/{purchaseId}": {
      "schema": {
        "$ref": "#/entities/Purchase"
      },
      "description": "Stores user purchases."
    },
    "/downloads/{downloadId}": {
      "schema": {
        "$ref": "#/entities/Download"
      },
      "description": "Stores download logs for security."
    }
  }
}
